   180	async function runPhase(
   181	  definitions: readonly TaskQualityStageDefinition[],
   182	  roots: TaskQualityRoots,
   183	  run: TaskQualityCommandRunner,
   184	): Promise<TaskQualityStageReceipt[]> {
   185	  const settled = await Promise.allSettled(
   186	    definitions.map((stage) => runStage(stage, roots, run)),
   187	  );
   188	  return settled.map((result, index) => {
   189	    if (result.status === "fulfilled") return result.value;
   190	    const stage = definitions[index];
   191	    if (!stage) throw new Error("task-quality phase result index mismatch");
   192	    const receipt: TaskQualityStageReceipt = {
   193	      ...blocked(stage),
   194	      status: "failed",
   195	      cleanup_errors: [
   196	        result.reason instanceof Error
   197	          ? result.reason.message
   198	          : String(result.reason),
   199	      ],
   200	      diagnostic: "stage runner rejected",
   201	    };
   202	    progress(stage, "finished", receipt);
   203	    return receipt;
   204	  });
   205	}
