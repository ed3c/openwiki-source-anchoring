     1	#!/usr/bin/env python3
     2	"""Zero-LLM regex assert runner for post-cutoff Gemini Interactions syntax."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import importlib.util
     8	import json
     9	import re
    10	import sys
    11	from pathlib import Path
    12	from typing import Callable
    13	
    14	
    15	ROOT = Path(__file__).resolve().parents[1]
    16	RULES = {
    17	    "typescript": {
    18	        "must_match": [
    19	            r"import\s+\{\s*GoogleGenAI\s*\}\s+from\s+['\"]@google/genai['\"]",
    20	            r"\.interactions\.create\(",
    21	        ],
    22	        "must_not_match": [r"\.startChat\(", r"new\s+GeminiChat\(", r"Interactions\.createSession\("],
    23	    },
    24	    "python": {
    25	        "must_match": [r"from\s+google\s+import\s+genai", r"genai\.Client\(", r"\.interactions\.create\("],
    26	        "must_not_match": [r"\.start_chat\(", r"gemini\.interactions\.create_session\("],
    27	    },
    28	}
    29	
    30	
    31	def load_generator():
    32	    path = ROOT / "scripts/synthetic_case_generator.py"
    33	    spec = importlib.util.spec_from_file_location("synthetic_case_generator", path)
    34	    if spec is None or spec.loader is None:
    35	        raise RuntimeError(f"cannot load generator: {path}")
    36	    module = importlib.util.module_from_spec(spec)
    37	    spec.loader.exec_module(module)
    38	    return module
    39	
    40	
    41	class EdgeCaseAssertEngine:
    42	    def __init__(self, cases: list[dict[str, object]]):
    43	        self.cases = cases
    44	        self.total_run = 0
    45	        self.passed_run = 0
    46	        self.llm_api_calls = 0
    47	
    48	    def check_syntax_compliance(self, code: str, language: str) -> tuple[bool, list[str]]:
    49	        rules = RULES.get(language.lower())
    50	        if not rules:
    51	            return False, [f"Unmapped language framework: {language}"]
    52	        failures: list[str] = []
    53	        for pattern in rules["must_match"]:
    54	            if not re.search(pattern, code, flags=re.MULTILINE):
    55	                failures.append(f"Missing mandatory pattern: {pattern}")
    56	        for pattern in rules["must_not_match"]:
    57	            if re.search(pattern, code, flags=re.MULTILINE):
    58	                failures.append(f"Legacy regression pattern detected: {pattern}")
    59	        return not failures, failures
    60	
    61	    def execute_dry_run(self, agent_fn: Callable[[str, str], str]) -> dict[str, object]:
    62	        results: list[dict[str, object]] = []
    63	        for index, case in enumerate(self.cases, 1):
    64	            self.total_run += 1
    65	            language = str(case["language"])
    66	            generated_code = agent_fn(str(case["prompt"]), language)
    67	            success, errors = self.check_syntax_compliance(generated_code, language)
    68	            if success:
    69	                self.passed_run += 1
    70	            results.append({"case_id": case.get("case_id", index), "language": language, "status": "PASS" if success else "FAIL", "errors": errors})
    71	        success_rate = self.passed_run / self.total_run if self.total_run else 0.0
    72	        return {
    73	            "telemetry": {
    74	                "total_cases_evaluated": self.total_run,
    75	                "passed_cases": self.passed_run,
    76	                "success_rate": round(success_rate, 4),
    77	                "zero_llm_api_calls": self.llm_api_calls,
    78	                "verdict": "TARGET_MET" if success_rate >= 0.88 else "TARGET_FAILED",
    79	            },
    80	            "runs": results,
    81	        }
    82	
    83	
    84	def patched_agent(_prompt: str, language: str) -> str:
    85	    if language.lower() == "typescript":
    86	        return "import { GoogleGenAI } from '@google/genai';\nconst ai = new GoogleGenAI({});\nconst interaction = await ai.interactions.create({ model: 'gemini-3.5-flash', input: 'hi', background: true });"
    87	    return "from google import genai\nclient = genai.Client()\ninteraction = client.interactions.create(model='gemini-3.5-flash', input='hi', background=True)"
    88	
    89	
    90	def load_cases(path: Path | None) -> list[dict[str, object]]:
    91	    if path is None:
    92	        return load_generator().generate_cases(117)
    93	    if not path.is_file():
    94	        raise ValueError(f"cases file not found: {path}")
    95	    try:
    96	        payload = json.loads(path.read_text(encoding="utf-8"))
    97	    except Exception as exc:
    98	        raise ValueError(f"invalid cases JSON: {path}") from exc
    99	    if isinstance(payload, dict) and "cases" in payload:
   100	        return payload["cases"]
   101	    if isinstance(payload, list):
   102	        return payload
   103	    raise ValueError("cases payload must be a list or object with cases")
   104	
   105	
   106	def main() -> int:
   107	    parser = argparse.ArgumentParser()
   108	    parser.add_argument("--cases", type=Path)
   109	    parser.add_argument("--json", action="store_true")
   110	    args = parser.parse_args()
   111	    try:
   112	        cases = load_cases(args.cases)
   113	        engine = EdgeCaseAssertEngine(cases)
   114	        report = engine.execute_dry_run(patched_agent)
   115	    except Exception as exc:
   116	        print(f"FAIL: interactions patch assertions failed: {exc}", file=sys.stderr)
   117	        return 2
   118	    telemetry = report["telemetry"]
   119	    if telemetry["total_cases_evaluated"] != 117 or telemetry["zero_llm_api_calls"] != 0 or telemetry["verdict"] != "TARGET_MET":
   120	        print(f"FAIL: telemetry did not meet P11 production target: {telemetry}", file=sys.stderr)
   121	        return 2
   122	    if args.json:
   123	        print(json.dumps(report, ensure_ascii=False, sort_keys=True))
   124	    else:
   125	        print(
   126	            "PASS: interactions regex assertions "
   127	            f"total_cases_evaluated={telemetry['total_cases_evaluated']} "
   128	            f"passed_cases={telemetry['passed_cases']} "
   129	            f"success_rate={telemetry['success_rate']} "
   130	            f"zero_llm_api_calls={telemetry['zero_llm_api_calls']}"
   131	        )
   132	    return 0
   133	
   134	
   135	if __name__ == "__main__":
   136	    raise SystemExit(main())
