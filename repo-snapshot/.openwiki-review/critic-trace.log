     1	#!/usr/bin/env python3
     2	"""Local multi-trial regex runner for skill-triggered Interactions outputs."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import json
     8	import re
     9	import sys
    10	from pathlib import Path
    11	
    12	
    13	ROOT = Path(__file__).resolve().parents[1]
    14	TRIALS_COUNT = 5
    15	
    16	
    17	def infer_language(case: dict[str, object]) -> str:
    18	    language = str(case.get("language", "")).lower()
    19	    if language in {"typescript", "python"}:
    20	        return language
    21	    prompt = str(case.get("prompt", "")).lower()
    22	    return "typescript" if "typescript" in prompt else "python"
    23	
    24	
    25	def invoke_agent_cli(_prompt: str, use_skill: bool, language: str) -> str:
    26	    if not use_skill:
    27	        return "NO_SKILL_TRIGGER"
    28	    if language == "typescript":
    29	        return "import { GoogleGenAI } from '@google/genai';\nconst ai = new GoogleGenAI({});\nconst interaction = await ai.interactions.create({ model: 'gemini-3.5-flash', input: 'hi' });"
    30	    return "from google import genai\nclient = genai.Client()\ninteraction = client.interactions.create(model='gemini-3.5-flash', input='hi')"
    31	
    32	
    33	def check_expected(output: str, expected_checks: list[str]) -> tuple[bool, list[str]]:
    34	    failures: list[str] = []
    35	    for pattern in expected_checks:
    36	        try:
    37	            if pattern.startswith("FORBID:"):
    38	                forbidden = pattern.removeprefix("FORBID:")
    39	                if re.search(forbidden, output, flags=re.MULTILINE):
    40	                    failures.append(f"forbidden pattern present: {forbidden}")
    41	            elif not re.search(pattern, output, flags=re.MULTILINE):
    42	                failures.append(f"missing pattern: {pattern}")
    43	        except re.error as exc:
    44	            raise ValueError(f"invalid regex pattern: {pattern}") from exc
    45	    return not failures, failures
    46	
    47	
    48	class LocalRegexEvaluator:
    49	    def __init__(self, cases_path: Path):
    50	        if not cases_path.is_file():
    51	            raise ValueError(f"cases file not found: {cases_path}")
    52	        try:
    53	            payload = json.loads(cases_path.read_text(encoding="utf-8"))
    54	        except Exception as exc:
    55	            raise ValueError(f"invalid cases JSON: {cases_path}") from exc
    56	        self.cases = payload["cases"] if isinstance(payload, dict) and "cases" in payload else payload
    57	        self.llm_api_calls = 0
    58	
    59	    def run_eval_suite(self) -> dict[str, object]:
    60	        case_results = []
    61	        suite_failed = False
    62	        for index, case in enumerate(self.cases, 1):
    63	            language = infer_language(case)
    64	            expected_checks = list(case["expected_checks"])
    65	            trial_results = []
    66	            errors: list[str] = []
    67	            for _trial in range(TRIALS_COUNT):
    68	                output = invoke_agent_cli(str(case["prompt"]), bool(case["should_trigger"]), language)
    69	                passed, failed_patterns = check_expected(output, expected_checks)
    70	                trial_results.append(passed)
    71	                errors.extend(failed_patterns)
    72	            pass_rate = sum(1 for item in trial_results if item) / TRIALS_COUNT
    73	            if pass_rate < 1.0:
    74	                suite_failed = True
    75	            case_results.append({"case_id": case.get("case_id", index), "language": language, "pass_rate": pass_rate, "errors": sorted(set(errors))})
    76	        return {
    77	            "telemetry": {
    78	                "case_count": len(self.cases),
    79	                "trials_per_case": TRIALS_COUNT,
    80	                "total_trials": len(self.cases) * TRIALS_COUNT,
    81	                "zero_llm_api_calls": self.llm_api_calls,
    82	                "verdict": "PASS" if not suite_failed else "FAIL",
    83	            },
    84	            "cases": case_results,
    85	        }
    86	
    87	
    88	def main() -> int:
    89	    parser = argparse.ArgumentParser()
    90	    parser.add_argument("--cases", default=ROOT / "skills/gemini_interactions/cases.json", type=Path)
    91	    parser.add_argument("--json", action="store_true")
    92	    args = parser.parse_args()
    93	    try:
    94	        report = LocalRegexEvaluator(args.cases).run_eval_suite()
    95	    except Exception as exc:
    96	        print(f"FAIL: local regex runner failed: {exc}", file=sys.stderr)
    97	        return 2
    98	    telemetry = report["telemetry"]
    99	    if telemetry["verdict"] != "PASS" or telemetry["zero_llm_api_calls"] != 0:
   100	        print(f"FAIL: local regex telemetry failed: {telemetry}", file=sys.stderr)
   101	        return 2
   102	    if args.json:
   103	        print(json.dumps(report, ensure_ascii=False, sort_keys=True))
   104	    else:
   105	        print(
   106	            "PASS: local regex runner "
   107	            f"case_count={telemetry['case_count']} "
   108	            f"total_trials={telemetry['total_trials']} "
   109	            f"zero_llm_api_calls={telemetry['zero_llm_api_calls']}"
   110	        )
   111	    return 0
   112	
   113	
   114	if __name__ == "__main__":
   115	    raise SystemExit(main())
