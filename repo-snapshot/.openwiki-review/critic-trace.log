     1	#!/usr/bin/env python3
     2	"""Generate deterministic 117-case Interactions API regex fixtures."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import json
     8	import sys
     9	from pathlib import Path
    10	
    11	
    12	SCENARIOS = (
    13	    "multi-turn assistant",
    14	    "background session",
    15	    "low latency routing",
    16	    "tool invocation",
    17	    "streaming response",
    18	    "session variable storage",
    19	    "resume conversation",
    20	    "error recovery",
    21	    "typed config",
    22	    "migration from v2 chat",
    23	)
    24	
    25	
    26	def language_for(index: int) -> str:
    27	    return "typescript" if index % 2 else "python"
    28	
    29	
    30	def expected_checks(language: str) -> list[str]:
    31	    if language == "typescript":
    32	        return [
    33	            r"import\s+\{\s*GoogleGenAI\s*\}\s+from\s+['\"]@google/genai['\"]",
    34	            r"\.interactions\.create\(",
    35	            r"FORBID:\.startChat\(",
    36	            r"FORBID:new\s+GeminiChat\(",
    37	            r"FORBID:Interactions\.createSession\(",
    38	        ]
    39	    return [
    40	        r"from\s+google\s+import\s+genai",
    41	        r"genai\.Client\(",
    42	        r"\.interactions\.create\(",
    43	        r"FORBID:\.start_chat\(",
    44	        r"FORBID:gemini\.interactions\.create_session\(",
    45	    ]
    46	
    47	
    48	def generate_cases(total: int = 117) -> list[dict[str, object]]:
    49	    cases: list[dict[str, object]] = []
    50	    for index in range(1, total + 1):
    51	        language = language_for(index)
    52	        scenario = SCENARIOS[(index - 1) % len(SCENARIOS)]
    53	        prompt = (
    54	            f"Case {index}: build a {scenario} using the newest Gemini Interactions API; "
    55	            "avoid legacy v2 chat naming even when the request mentions chat/session continuity."
    56	        )
    57	        cases.append(
    58	            {
    59	                "case_id": f"P11-{index:03d}",
    60	                "prompt": prompt,
    61	                "language": language,
    62	                "should_trigger": True,
    63	                "expected_checks": expected_checks(language),
    64	            }
    65	        )
    66	    return cases
    67	
    68	
    69	def main() -> int:
    70	    parser = argparse.ArgumentParser()
    71	    parser.add_argument("--output", type=Path)
    72	    parser.add_argument("--total", default=117, type=int)
    73	    parser.add_argument("--json", action="store_true")
    74	    args = parser.parse_args()
    75	    if args.total != 117:
    76	        print("FAIL: production P11 matrix must contain exactly 117 cases", file=sys.stderr)
    77	        return 2
    78	    cases = generate_cases(args.total)
    79	    language_counts = {lang: sum(1 for case in cases if case["language"] == lang) for lang in ("typescript", "python")}
    80	    payload = {"case_count": len(cases), "language_counts": language_counts, "cases": cases}
    81	    text = json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    82	    if args.output:
    83	        args.output.parent.mkdir(parents=True, exist_ok=True)
    84	        args.output.write_text(text, encoding="utf-8")
    85	    elif args.json:
    86	        print(text, end="")
    87	    print(f"PASS: generated synthetic_cases={len(cases)} typescript={language_counts['typescript']} python={language_counts['python']}", file=sys.stderr)
    88	    return 0
    89	
    90	
    91	if __name__ == "__main__":
    92	    raise SystemExit(main())
