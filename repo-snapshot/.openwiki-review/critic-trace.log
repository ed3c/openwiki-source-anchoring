   232	function record(value: unknown): value is Record<string, unknown> {
   233	  return value !== null && typeof value === "object" && !Array.isArray(value);
   234	}
   235	
   236	function stageErrors(
   237	  value: unknown,
   238	  expected: TaskQualityStageDefinition,
   239	): string[] {
   240	  if (!record(value)) return [`stage ${expected.id} missing`];
   241	  const errors: string[] = [];
   242	  if (value.id !== expected.id) errors.push(`stage ${expected.id} id`);
   243	  if (value.phase !== expected.phase) errors.push(`stage ${expected.id} phase`);
   244	  if (value.cwd !== expected.cwd) errors.push(`stage ${expected.id} cwd`);
   245	  if (JSON.stringify(value.command) !== JSON.stringify(expected.command))
   246	    errors.push(`stage ${expected.id} command`);
   247	  if (value.status !== "passed") errors.push(`stage ${expected.id} status`);
   248	  if (value.exit_code !== 0) errors.push(`stage ${expected.id} exit_code`);
   249	  if (typeof value.elapsed_ms !== "number" || value.elapsed_ms < 0)
   250	    errors.push(`stage ${expected.id} elapsed_ms`);
   251	  for (const field of [
   252	    "process_reaped",
   253	    "timer_cleared",
   254	    "stdout_consumed",
   255	    "stderr_consumed",
   256	  ]) {
   257	    if (value[field] !== true) errors.push(`stage ${expected.id} ${field}`);
   258	  }
   259	  if (
   260	    !Array.isArray(value.cleanup_errors) ||
   261	    value.cleanup_errors.length !== 0
   262	  ) {
   263	    errors.push(`stage ${expected.id} cleanup_errors`);
   264	  }
   265	  if (
   266	    expected.command[0] === "bun" &&
   267	    expected.command[1] === "test" &&
   268	    (typeof value.test_cases !== "number" || value.test_cases < 1)
   269	  ) {
   270	    errors.push(`stage ${expected.id} test_cases`);
   271	  }
   272	  return errors;
   273	}
