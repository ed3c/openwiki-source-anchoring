   112	async function runStage(
   113	  stage: TaskQualityStageDefinition,
   114	  roots: TaskQualityRoots,
   115	  run: TaskQualityCommandRunner,
   116	): Promise<TaskQualityStageReceipt> {
   117	  progress(stage, "started");
   118	  const started = performance.now();
   119	  const result = await run(stage.command, roots[stage.cwd], stage.timeout_ms);
   120	  const testStage = isTestStage(stage);
   121	  const observedTestCases = testStage
   122	    ? testCases(`${result.stdout}\n${result.stderr}`)
   123	    : null;
   124	  const passed = clean(result) && (!testStage || observedTestCases !== null);
   125	  const receipt: TaskQualityStageReceipt = {
   126	    id: stage.id,
   127	    phase: stage.phase,
   128	    cwd: stage.cwd,
   129	    command: [...stage.command],
   130	    status: passed ? "passed" : "failed",
   131	    exit_code: result.exitCode,
   132	    elapsed_ms: Math.round(performance.now() - started),
   133	    timed_out: result.timedOut,
   134	    cancelled: false,
   135	    process_reaped: result.processReaped,
   136	    timer_cleared: result.timerCleared,
   137	    stdout_consumed: result.stdoutConsumed,
   138	    stderr_consumed: result.stderrConsumed,
   139	    cleanup_errors: [...result.cleanupErrors],
   140	    stdout_sha256: sha256(result.stdout),
   141	    stderr_sha256: sha256(result.stderr),
   142	    test_cases: observedTestCases,
   143	    diagnostic: passed
   144	      ? "passed"
   145	      : testStage && observedTestCases === null && clean(result)
   146	        ? "test command reported no executed tests"
   147	        : (
   148	            result.stderr.trim() ||
   149	            result.stdout.trim() ||
   150	            `exit ${result.exitCode}`
   151	          ).slice(-2_000),
   152	  };
   153	  progress(stage, "finished", receipt);
   154	  return receipt;
   155	}
