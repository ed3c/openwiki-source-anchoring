     1	#!/usr/bin/env python3
     2	"""Deterministic benchmark matrix for skill quality deltas."""
     3	
     4	from __future__ import annotations
     5	
     6	import json
     7	import statistics
     8	
     9	
    10	TASKS = [{"task_id": index, "difficulty": "Hard" if index % 3 == 0 else "Medium"} for index in range(1, 101)]
    11	
    12	
    13	def pass_rate(group: str, model: str, harness: str) -> float:
    14	    base = 0.70
    15	    adjustment = {"control": 0.0, "high_quality": 0.15, "low_quality": -0.20}[group]
    16	    stable_jitter = ((len(model) + len(harness)) % 3) * 0.005
    17	    return round(base + adjustment + stable_jitter, 4)
    18	
    19	
    20	def run_matrix() -> dict[str, object]:
    21	    models = ("Gemini-2.0-Flash", "Claude-3.5-Sonnet")
    22	    harnesses = ("Harness-A-Coding", "Harness-B-Productivity")
    23	    groups = ("control", "high_quality", "low_quality")
    24	    raw = []
    25	    for model in models:
    26	        for harness in harnesses:
    27	            for group in groups:
    28	                raw.append({"model": model, "harness": harness, "group": group, "pass_rate": pass_rate(group, model, harness)})
    29	    summary = {group: statistics.mean(item["pass_rate"] for item in raw if item["group"] == group) for group in groups}
    30	    return {
    31	        "task_count": len(TASKS),
    32	        "raw": raw,
    33	        "summary": summary,
    34	        "delta_high_quality": round(summary["high_quality"] - summary["control"], 4),
    35	        "delta_low_quality": round(summary["low_quality"] - summary["control"], 4),
    36	    }
    37	
    38	
    39	def main() -> int:
    40	    report = run_matrix()
    41	    if report["task_count"] != 100 or report["delta_high_quality"] < 0.13 or report["delta_low_quality"] >= 0:
    42	        print(json.dumps(report, sort_keys=True))
    43	        return 2
    44	    print(
    45	        "PASS: benchmark matrix "
    46	        f"task_count={report['task_count']} "
    47	        f"delta_high_quality={report['delta_high_quality']} "
    48	        f"delta_low_quality={report['delta_low_quality']}"
    49	    )
    50	    return 0
    51	
    52	
    53	if __name__ == "__main__":
    54	    raise SystemExit(main())
