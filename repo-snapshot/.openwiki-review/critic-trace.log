    26	    )
    27	    if result.returncode != 0:
    28	        if "not a git repository" in result.stderr:
    29	            return []
    30	        raise RuntimeError(result.stderr.strip() or "git status failed")
    31	    paths: list[Path] = []
    32	    for line in result.stdout.splitlines():
    33	        match = re.search(CASE_PATH, line)
    34	        if match:
    35	            paths.append(ROOT / match.group(1))
    36	    return paths
    37	
    38	
    39	def all_case_files() -> list[Path]:
    40	    return sorted((ROOT / "skills").glob("*/cases.json"))
    41	
    42	
    43	def main() -> int:
    44	    parser = argparse.ArgumentParser()
    45	    parser.add_argument("--all", action="store_true", help="scan every skills/*/cases.json file")
    46	    args = parser.parse_args()
    47	    try:
    48	        paths = all_case_files() if args.all else modified_case_files()
    49	        if not paths:
    50	            paths = all_case_files()
    51	        if not paths:
    52	            print("FAIL: no skills/*/cases.json files found", file=sys.stderr)
    53	            return 2
    54	        for path in paths:
    55	            validator.validate_cases(path)
    56	    except Exception as exc:
    57	        print(f"FAIL: skill baseline validation failed: {exc}", file=sys.stderr)
    58	        return 2
    59	    print(f"PASS: skill baseline validated cases={len(paths)} mode={'all' if args.all else 'git-diff-or-all'}")
    60	    return 0
    61	
    62	
    63	if __name__ == "__main__":
    64	    sys.exit(main())
FILE scripts/validator.py
     1	#!/usr/bin/env python3
     2	"""Validate skill cases.json files with the GCR minimum baseline."""
     3	
     4	from __future__ import annotations
     5	
     6	import json
     7	import argparse
     8	import os
     9	import sys
    10	from difflib import SequenceMatcher
    11	from pathlib import Path
    12	from typing import Any
    13	
    14	
    15	ROOT = Path(os.environ.get("VALIDATOR_ROOT", Path(__file__).resolve().parents[1]))
    16	WEAK_PATTERNS = {"", ".*", ".+", "^.*$", "^.+$"}
    17	
    18	
    19	def fail(message: str) -> None:
    20	    raise ValueError(message)
    21	
    22	
    23	def validate_case(case: dict[str, Any], index: int) -> None:
    24	    for field in ("id", "prompt", "should_trigger", "expected_checks"):
    25	        if field not in case:
    26	            fail(f"case {index} missing field: {field}")
    27	    if not isinstance(case["prompt"], str) or not case["prompt"].strip():
    28	        fail(f"case {index} prompt must be non-empty text")
    29	    if not isinstance(case["should_trigger"], bool):
    30	        fail(f"case {index} should_trigger must be boolean")
    31	    checks = case["expected_checks"]
    32	    if not isinstance(checks, list) or not checks:
    33	        fail(f"case {index} expected_checks must be a non-empty list")
    34	    for check in checks:
    35	        if not isinstance(check, str) or check.strip() in WEAK_PATTERNS:
    36	            fail(f"case {index} has weak expected check: {check!r}")
    37	
    38	
    39	def validate_cases(path: Path) -> None:
    40	    try:
    41	        text = path.read_bytes().decode("utf-8")
    42	    except UnicodeDecodeError as exc:
    43	        fail(f"{path}: invalid UTF-8 cases JSON")
    44	    try:
    45	        cases = json.loads(text)
    46	    except Exception as exc:
    47	        fail(f"{path}: invalid cases JSON")
    48	    if not isinstance(cases, list):
    49	        fail(f"{path}: root must be a JSON array")
    50	    if not 10 <= len(cases) <= 20:
    51	        fail(f"{path}: expected 10-20 cases, got {len(cases)}")
    52	    for index, case in enumerate(cases, 1):
    53	        if not isinstance(case, dict):
    54	            fail(f"case {index} must be an object")
    55	        validate_case(case, index)
    56	    positives = sum(1 for case in cases if case["should_trigger"])
    57	    negatives = len(cases) - positives
    58	    if positives < 5 or negatives < 5:
    59	        fail(f"{path}: expected 5+ positive and 5+ negative cases")
    60	    prompts = [case["prompt"].lower() for case in cases]
    61	    for left in range(len(prompts)):
    62	        for right in range(left + 1, len(prompts)):
    63	            if SequenceMatcher(None, prompts[left], prompts[right]).ratio() > 0.85:
    64	                fail(f"{path}: near-duplicate prompts: {left + 1}, {right + 1}")
    65	
    66	
    67	def main() -> int:
    68	    parser = argparse.ArgumentParser()
    69	    parser.add_argument("--json", action="store_true", help="emit machine-readable telemetry")
    70	    args = parser.parse_args()
    71	    paths = sorted((ROOT / "skills").glob("*/cases.json"))
    72	    if not paths:
    73	        print("FAIL: no skills/*/cases.json files found", file=sys.stderr)
    74	        return 2
    75	    try:
    76	        for path in paths:
    77	            validate_cases(path)
    78	    except Exception as exc:
    79	        print(f"FAIL: {exc}", file=sys.stderr)
    80	        return 2
    81	    if args.json:
    82	        print(json.dumps({"validated_case_files": len(paths), "verdict": "PASS"}, sort_keys=True))
    83	        return 0
    84	    print(f"PASS: validated {len(paths)} skill case file(s)")
    85	    return 0
    86	
    87	
    88	if __name__ == "__main__":
    89	    raise SystemExit(main())

