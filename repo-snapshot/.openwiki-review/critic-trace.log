     5	
     6	export type PreflightCheck = { id: string; status: "passed" | "failed"; detail: string };
     7	
     8	type TerminalPacket = {
     9	  schema_version: "terminal-slice-packet@v1" | "terminal-slice-packet@v2";
    10	  terminal_slice_id?: string;
    11	  guided_claim_ids: string[];
