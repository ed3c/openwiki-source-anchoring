FILE scripts/github_skill_harvester.py
     1	#!/usr/bin/env python3
     2	"""Harvest local skill asset metrics without network access."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import json
     8	import math
     9	import re
    10	import sys
    11	from concurrent.futures import ThreadPoolExecutor
    12	from pathlib import Path
    13	
    14	
    15	ROOT = Path(__file__).resolve().parents[1]
    16	NO_OPS_KEYWORDS = ("please", "highly recommended", "best practice", "easy to read", "beautiful code")
    17	
    18	
    19	def calculate_entropy(text: str) -> float:
    20	    clean_text = re.sub(r"\s+", "", text)
    21	    if not clean_text:
    22	        return 0.0
    23	    frequencies: dict[str, int] = {}
    24	    for char in clean_text:
    25	        frequencies[char] = frequencies.get(char, 0) + 1
    26	    entropy = 0.0
    27	    for count in frequencies.values():
    28	        p = count / len(clean_text)
    29	        entropy -= p * math.log2(p)
    30	    return entropy
    31	
    32	
    33	def harvest_single_file(path: Path) -> dict[str, object]:
    34	    text = path.read_text(encoding="utf-8", errors="ignore")
    35	    words = text.split()
    36	    word_count = len(words)
    37	    lowered = text.lower()
    38	    no_ops_count = sum(lowered.count(term) for term in NO_OPS_KEYWORDS)
    39	    no_ops_density = no_ops_count / max(word_count, 1)
    40	    entropy = calculate_entropy(text)
    41	    return {
    42	        "file_path": str(path),
    43	        "word_count": word_count,
    44	        "no_ops_density": round(no_ops_density, 4),
    45	        "entropy": round(entropy, 4),
    46	        "is_suspected_ai_generated": word_count > 500 or (entropy < 4.5 and no_ops_density > 0.05),
    47	    }
    48	
    49	
    50	def scan_ecosystem(workspace: Path, max_workers: int = 8) -> list[dict[str, object]]:
    51	    skill_files = sorted(workspace.glob("skills/*/skills.md"))
    52	    with ThreadPoolExecutor(max_workers=max_workers) as executor:
    53	        return list(executor.map(harvest_single_file, skill_files))
    54	
    55	
    56	def main() -> int:
    57	    parser = argparse.ArgumentParser()
    58	    parser.add_argument("--workspace", default=ROOT, type=Path)
    59	    parser.add_argument("--json", action="store_true")
    60	    args = parser.parse_args()
    61	    try:
    62	        results = scan_ecosystem(args.workspace)
    63	    except Exception as exc:
    64	        print(f"FAIL: harvest failed: {exc}", file=sys.stderr)
    65	        return 2
    66	    if not results:
    67	        print("FAIL: no skill assets found", file=sys.stderr)
    68	        return 2
    69	    payload = {"skill_count": len(results), "skills": results}
    70	    if args.json:
    71	        print(json.dumps(payload, ensure_ascii=False, sort_keys=True))
    72	    else:
    73	        print(f"PASS: harvested skill_count={len(results)} suspected_ai={sum(1 for item in results if item['is_suspected_ai_generated'])}")
    74	    return 0
    75	
    76	
    77	if __name__ == "__main__":
    78	    raise SystemExit(main())
