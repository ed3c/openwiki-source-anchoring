    64	  if (!scriptArg || packet.entrypoint?.[0] !== "bun" || packet.entrypoint[1] !== "run") {
    65	    return failed("entrypoint-reachable", "entrypoint must begin with bun run <script>");
    66	  }
    67	  try {
    68	    const realScript = realpathSync(resolve(target, scriptArg));
    69	    if (!contained(realpathSync(workspaceRoot), realScript)) return failed("entrypoint-reachable", "entrypoint escapes workspace");
    70	    if (!statSync(realScript).isFile()) return failed("entrypoint-reachable", "entrypoint is not a regular file");
    71	    return passed("entrypoint-reachable", relative(target, realScript));
    72	  } catch (error) {
    73	    return failed("entrypoint-reachable", diagnostic(error));
    74	  }
    75	}
