    library.close();
  } catch (error) {
    failures.push(error);
  }
  for (const descriptor of descriptors.reverse()) {
    try {
      closeSync(descriptor);
    } catch (error) {
      failures.push(error);
    }
  }
  if (failures.length > 1)
    throw new AggregateError(
      failures,
      "writer directory open and cleanup failed",
    );
