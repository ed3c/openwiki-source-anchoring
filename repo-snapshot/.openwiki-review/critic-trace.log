    62	    timer_cleared: true,
    63	    stdout_consumed: true,
    64	    stderr_consumed: true,
    65	  };
    66	  const failures = Object.entries(expected)
    67	    .filter(([field, expectedValue]) => value[field] !== expectedValue)
    68	    .map(([field]) => `inner ${field}`);
    69	  if (!Array.isArray(value.cleanup_errors) || value.cleanup_errors.length !== 0)
    70	    failures.push("inner cleanup_errors");
    71	  if (
    72	    JSON.stringify(value.command) !==
    73	    JSON.stringify(REPO_TERMINAL_CODE_QUALITY_COMMAND)
    74	  ) {
    75	    failures.push("inner command");
    76	  }
    77	  failures.push(...taskQualityReceiptErrors(value));
    78	  return failures;
    79	}
    80	
    81	function productionErrors(
    82	  value: Record<string, unknown>,
    83	  workspaceRoot: string,
    84	): string[] {
    85	  const errors: string[] = [];
    86	  const safety = verifiedProductionSafety(value, "writer-entrypoint").sort();
    87	  const expectedSafety = ["race-condition", "resource-leak", "silent-failure"];
    88	  if (JSON.stringify(safety) !== JSON.stringify(expectedSafety))
    89	    errors.push("production safety evidence incomplete");
    90	  const summary: ProfileSummary = {
    91	    declared: 1,
    92	    executed: 1,
    93	    artifact:
    94	      typeof value.artifact_path === "string" ? value.artifact_path : null,
    95	    artifactSha256:
    96	      typeof value.artifact_sha256 === "string" ? value.artifact_sha256 : null,
    97	    safety,
    98	    evidenceScope:
    99	      typeof value.evidence_scope === "string" ? value.evidence_scope : null,
   100	    requiredEvidenceScope: "writer-entrypoint",
   101	  };
   102	  validateProductionArtifact(workspaceRoot, summary, errors);
   103	  return errors;
   104	}
   105	
   106	export function gateReceiptErrors(
   107	  name: "code-quality" | "production-use",
   108	  result: BoundedProcessResult,
   109	  workspaceRoot: string,
   110	): string[] {
   111	  const value = receipt(result);
   112	  const schema =
   113	    name === "code-quality"
   114	      ? "repo-terminal-code-quality-receipt@v1"
   115	      : "repo-terminal-writer-production-journey-receipt@v2";
   116	  if (!value || value.schema_version !== schema || value.status !== "passed")
   117	    return [`typed receipt must pass ${schema}`];
   118	  return name === "code-quality"
   119	    ? codeQualityErrors(value)
   120	    : productionErrors(value, workspaceRoot);
   121	}

