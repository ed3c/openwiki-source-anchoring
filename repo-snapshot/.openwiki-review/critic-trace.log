    47	}
    48	
    49	function describeOrSelftest(action: string): number {
    50	  if (action !== "--describe" && action !== "--selftest") return 64;
    51	  const result = describe();
    52	  if (action === "--selftest" && (result.code_quality_commands < 1 || result.production_use_commands < 1)) {
    53	    console.error("FAIL: both profiles require a real argv command");
    54	    return 2;
    55	  }
    56	  console.log(JSON.stringify({ ...result, status: "passed" }));
