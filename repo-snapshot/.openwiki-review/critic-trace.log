   207	export async function executeTaskQuality(
   208	  roots: TaskQualityRoots,
   209	  run: TaskQualityCommandRunner = runOwnedProfileCommand,
   210	): Promise<TaskQualityReceipt> {
   211	  const started = performance.now();
   212	  const receipts: TaskQualityStageReceipt[] = [];
   213	  for (const phase of [
   214	    ...new Set(TASK_QUALITY_STAGE_DEFINITIONS.map((stage) => stage.phase)),
