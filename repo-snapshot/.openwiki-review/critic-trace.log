    15	    minimal_diff: { allowed_paths_only: boolean; unrelated_refactors: boolean };
    16	  };
    17	  target_repo: string;
    18	  entrypoint?: string[];
    19	  allowed_paths: string[];
    20	  write_lease: { expires_at: string; expected_head: string };
    21	};
    22	
    23	function passed(id: string, detail: string): PreflightCheck {
    24	  return { id, status: "passed", detail };
    25	}
    26	
    27	function failed(id: string, detail: string): PreflightCheck {
    28	  return { id, status: "failed", detail };
    29	}
    30	
    31	function diagnostic(error: unknown): string {
    32	  return error instanceof Error ? error.message : String(error);
    33	}
    34	
    35	function contained(base: string, candidate: string): boolean {
    36	  const local = relative(base, candidate);
    37	  return !isAbsolute(local) && local !== ".." && !local.startsWith(`..${process.platform === "win32" ? "\\" : "/"}`);
    38	}
    39	
    40	function inputContract(inputPath: string, raw: Record<string, unknown> | null, workspaceRoot: string): PreflightCheck {
    41	  const schema = raw?.schema_version === "terminal-slice-packet@v2" ? "terminal-slice-packet@v2" : "terminal-slice-packet@v1";
    42	  const validation = spawnSync("bun", [
    43	    "run", resolve(workspaceRoot, "runtime/contracts/validate-packet.ts"),
    44	    "--schema", schema, "--input", inputPath,
    45	  ], { cwd: workspaceRoot, encoding: "utf8" });
    46	  const detail = validation.stdout.trim() || validation.stderr.trim();
    47	  return validation.status === 0 ? passed("input-contract", detail) : failed("input-contract", detail);
    48	}
    49	
    50	function readPacket(inputPath: string): { packet: TerminalPacket | null; raw: Record<string, unknown> | null; check?: PreflightCheck } {
    51	  try {
    52	    const parsed: unknown = JSON.parse(readFileSync(inputPath, "utf8"));
    53	    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
    54	      return { packet: null, raw: null, check: failed("input-readable", "terminal packet must be an object") };
    55	    }
    56	    return { packet: parsed as TerminalPacket, raw: parsed as Record<string, unknown> };
    57	  } catch (error) {
    58	    return { packet: null, raw: null, check: failed("input-readable", diagnostic(error)) };
    59	  }
    60	}
