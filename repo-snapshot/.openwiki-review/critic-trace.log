FILE scripts/no_ops_purger.py
     1	#!/usr/bin/env python3
     2	"""Prune no-op prompt lines only when deterministic behavior is preserved."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import re
     8	import sys
     9	from pathlib import Path
    10	
    11	
    12	ROOT = Path(__file__).resolve().parents[1]
    13	NO_OPS_PATTERNS = (
    14	    r"clean\s+code",
    15	    r"easy\s+to\s+read",
    16	    r"high\s+quality",
    17	    r"robust\s+architecture",
    18	    r"best\s+practice",
    19	    r"beautiful\s+code",
    20	    r"please",
    21	    r"highly\s+recommended",
    22	    r"優雅",
    23	    r"乾淨",
    24	    r"高質量",
    25	    r"最佳實踐",
    26	    r"請確保",
    27	    r"易讀",
    28	    r"健壯",
    29	)
    30	
    31	
    32	def run_p2_evaluation(skill_content: str) -> float:
    33	    if "Interactions" not in skill_content:
    34	        return 0.10
    35	    return 0.95
    36	
    37	
    38	def is_no_op_line(line: str) -> bool:
    39	    return any(re.search(pattern, line, re.IGNORECASE) for pattern in NO_OPS_PATTERNS)
    40	
    41	
    42	def purge_text(text: str) -> tuple[str, int, int]:
    43	    baseline = run_p2_evaluation(text)
    44	    pruned_lines = text.splitlines()
    45	    index = 0
    46	    purged_count = 0
    47	    while index < len(pruned_lines):
    48	        line = pruned_lines[index].strip()
    49	        if not line or not is_no_op_line(line):
    50	            index += 1
    51	            continue
    52	        candidate = list(pruned_lines)
    53	        candidate.pop(index)
    54	        candidate_text = "\n".join(candidate)
    55	        current_rate = run_p2_evaluation(candidate_text)
    56	        if current_rate >= baseline:
    57	            pruned_lines.pop(index)
    58	            purged_count += 1
    59	            baseline = current_rate
    60	        else:
    61	            index += 1
    62	    output = "\n".join(pruned_lines)
    63	    return output, purged_count, max((len(text) - len(output)) // 4, 0)
    64	
    65	
    66	def main() -> int:
    67	    parser = argparse.ArgumentParser()
    68	    parser.add_argument("--skill", default=ROOT / "skills/gemini_interactions/skills.md", type=Path)
    69	    args = parser.parse_args()
    70	    try:
    71	        if not args.skill.is_file():
    72	            raise ValueError(f"skill file not found: {args.skill}")
    73	        try:
    74	            text = args.skill.read_text(encoding="utf-8")
    75	        except UnicodeDecodeError as exc:
    76	            raise ValueError(f"invalid UTF-8 skill file: {args.skill}") from exc
    77	        _, purged_count, tokens_saved = purge_text(text)
    78	    except Exception as exc:
    79	        print(f"FAIL: no-ops purge failed: {exc}", file=sys.stderr)
    80	        return 2
    81	    print(f"PASS: no-ops purge checked purged_count={purged_count} tokens_saved={tokens_saved}")
    82	    return 0
    83	
    84	
    85	if __name__ == "__main__":
    86	    raise SystemExit(main())
