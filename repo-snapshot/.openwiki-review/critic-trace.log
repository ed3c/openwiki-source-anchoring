     1	#!/usr/bin/env python3
     2	"""Report P11 synthetic case corpus quality without upgrading canary truth."""
     3	
     4	from __future__ import annotations
     5	
     6	import argparse
     7	import importlib.util
     8	import json
     9	from collections import Counter
    10	from difflib import SequenceMatcher
    11	from pathlib import Path
    12	
    13	
    14	ROOT = Path(__file__).resolve().parents[1]
    15	
    16	
    17	def load_generator():
    18	    path = ROOT / "scripts/synthetic_case_generator.py"
    19	    spec = importlib.util.spec_from_file_location("synthetic_case_generator", path)
    20	    if spec is None or spec.loader is None:
    21	        raise RuntimeError(f"cannot load generator: {path}")
    22	    module = importlib.util.module_from_spec(spec)
    23	    spec.loader.exec_module(module)
    24	    return module
    25	
    26	
    27	def normalize_prompt(prompt: str) -> str:
    28	    return " ".join(prompt.lower().replace("case ", "").split())
    29	
    30	
    31	def scenario_from_prompt(prompt: str) -> str:
    32	    marker = "build a "
    33	    suffix = " using"
    34	    if marker in prompt and suffix in prompt:
    35	        return prompt.split(marker, 1)[1].split(suffix, 1)[0]
    36	    return "unknown"
    37	
    38	
    39	def max_template_similarity(prompts: list[str]) -> float:
    40	    if len(prompts) < 2:
    41	        return 0.0
    42	    best = 0.0
    43	    normalized = [normalize_prompt(prompt) for prompt in prompts]
    44	    for left in range(len(normalized)):
    45	        for right in range(left + 1, len(normalized)):
    46	            best = max(best, SequenceMatcher(None, normalized[left], normalized[right]).ratio())
    47	    return round(best, 4)
    48	
    49	
    50	def analyze_cases(cases: list[dict[str, object]]) -> dict[str, object]:
    51	    prompts = [str(case["prompt"]) for case in cases]
    52	    scenarios = [scenario_from_prompt(prompt) for prompt in prompts]
    53	    expected_sets = [tuple(case.get("expected_checks", [])) for case in cases]
    54	    language_counts = Counter(str(case.get("language", "unknown")) for case in cases)
    55	    should_trigger = Counter(bool(case.get("should_trigger", False)) for case in cases)
    56	    stats = {
    57	        "case_count": len(cases),
    58	        "unique_prompts": len(set(prompts)),
    59	        "unique_scenarios": len(set(scenarios)),
    60	        "language_counts": dict(sorted(language_counts.items())),
    61	        "unique_expected_check_sets": len(set(expected_sets)),
    62	        "trigger_true": should_trigger[True],
    63	        "trigger_false": should_trigger[False],
    64	        "negative_cases": should_trigger[False],
    65	        "legacy_bait_cases": sum("legacy" in prompt.lower() or "v2" in prompt.lower() or "startchat" in prompt.lower() for prompt in prompts),
    66	        "max_template_similarity_ratio": max_template_similarity(prompts),
    67	        "real_agent_runs": 0,
    68	        "llm_api_calls": 0,
    69	    }
    70	    insufficient_reasons = []
    71	    if stats["unique_expected_check_sets"] < 12:
    72	        insufficient_reasons.append("unique_expected_check_sets_lt_12")
    73	    if stats["negative_cases"] < 20:
    74	        insufficient_reasons.append("negative_cases_lt_20")
    75	    if stats["trigger_false"] < 10:
    76	        insufficient_reasons.append("non_trigger_cases_lt_10")
    77	    if stats["max_template_similarity_ratio"] > 0.35:
    78	        insufficient_reasons.append("template_similarity_gt_0_35")
    79	    stats["quality_status"] = "insufficient" if insufficient_reasons else "admissible-candidate"
    80	    stats["insufficient_reasons"] = insufficient_reasons
    81	    return stats
    82	
    83	
    84	def main() -> int:
    85	    parser = argparse.ArgumentParser()
    86	    parser.add_argument("--json", action="store_true")
    87	    args = parser.parse_args()
    88	    cases = load_generator().generate_cases(117)
    89	    stats = analyze_cases(cases)
    90	    if args.json:
    91	        print(json.dumps(stats, ensure_ascii=False, sort_keys=True))
    92	    else:
    93	        print(
    94	            "PASS: synthetic case quality perceived "
    95	            f"quality_status={stats['quality_status']} "
    96	            f"case_count={stats['case_count']} "
    97	            f"unique_scenarios={stats['unique_scenarios']} "
    98	            f"unique_expected_check_sets={stats['unique_expected_check_sets']} "
    99	            f"negative_cases={stats['negative_cases']} "
   100	            f"max_template_similarity_ratio={stats['max_template_similarity_ratio']}"
   101	        )
   102	    return 0
   103	
   104	
   105	if __name__ == "__main__":
   106	    raise SystemExit(main())
