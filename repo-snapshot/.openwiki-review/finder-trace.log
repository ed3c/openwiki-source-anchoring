      current,
      writerName(part),
      constants.O_RDONLY | constants.O_DIRECTORY | constants.O_NOFOLLOW,
      0,
    );
    if (next < 0)
      throw new Error(
        `writer directory component refused: ${part}; errno=${library.errno()}`,
      );
    descriptors.push(next);
    current = next;
  }
  return current;
}

function acquireWriterLock(
